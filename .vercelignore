# Vercel deploys only the web platform (api/index.py -> engine/app).  Everything
# below is for the desktop MOD, the knowledge base or local work, and would only
# slow the build.
_work/
total-bridge/
knowledge/
setup/
profiles/
MATERIALS/
**/__pycache__/
**/*.pdf
**/*.zip
**/*.jpg
**/*.jpeg
**/*.png
!engine/app/ui/**

# owner's competitor screenshots: reference only, never deployed
Competitors 3.6 software features pics/

# shared UI sources (built output is committed under engine/app/ui/)
ui-shared/

# Reference material the runtime never reads (the function stays well under
# Vercel's 250 MB with these out; before, a build script pruned them).  The
# runtime reads specs only through vercel.json "includeFiles": the D-1 sample
# XML, the update / completion report XML and the GSE XSD.
/3.6 DEVELOPMENT, BLUEPRINT, DOCUMENTATION/
/_ref/
/*.xlsx
/*.xlsm
/docs/
/desktop/
/brand/
/templates/
specs/official/_Loose_Files_From_Root/
specs/official/urar_*/
